<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>UnlockAllBackgrounds</AssemblyName>
    <RootNamespace>UnlockAllBackgrounds</RootNamespace>
    <Version>1.0.2</Version>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DeployToSPT Condition="'$(DeployToSPT)' == ''">false</DeployToSPT>
  </PropertyGroup>

  <PropertyGroup>
    <SPTPath Condition="'$(SPTPath)' == ''">$(SPT_PATH)</SPTPath>
    <SPTPath Condition="'$(SPTPath)' != ''">$(SPTPath.TrimEnd('\'))</SPTPath>
    <SPTRuntimePath Condition="Exists('$(SPTPath)\SPT_Runtime\SPTarkov.Server.Core.dll')">$(SPTPath)\SPT_Runtime</SPTRuntimePath>
    <SPTRuntimePath Condition="'$(SPTRuntimePath)' == ''">$(SPTPath)\SPT</SPTRuntimePath>
  </PropertyGroup>

  <Target Name="ValidateSPTPath" BeforeTargets="BeforeBuild">
    <Error Condition="'$(SPTPath)' == ''" Text="SPTPath is not set. e.g. -p:SPTPath=D:\Games\EscapeFromTarkov5.0" />
    <Error Condition="!Exists('$(SPTRuntimePath)\SPTarkov.Server.Core.dll')" Text="SPTPath ('$(SPTPath)') contains neither SPT_Runtime\ nor SPT\ with SPTarkov.Server.Core.dll" />
  </Target>

  <ItemGroup>
    <Reference Include="SPTarkov.Server.Core">
      <HintPath>$(SPTRuntimePath)\SPTarkov.Server.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.Common">
      <HintPath>$(SPTRuntimePath)\SPTarkov.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.DI">
      <HintPath>$(SPTRuntimePath)\SPTarkov.DI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SemanticVersioning">
      <HintPath>$(SPTRuntimePath)\SemanticVersioning.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="DeployToSPT" AfterTargets="Build" Condition="'$(DeployToSPT)' == 'true'">
    <PropertyGroup>
      <ModDir>$(SPTRuntimePath)\user\mods\UnlockAllBackgrounds</ModDir>
    </PropertyGroup>
    <MakeDir Directories="$(ModDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModDir)" />
  </Target>

  <Target Name="PackageRelease" DependsOnTargets="Build">
    <PropertyGroup>
      <StagingDir>$(MSBuildProjectDirectory)\dist\staging</StagingDir>
      <ModStageDir>$(StagingDir)\SPT_Runtime\user\mods\UnlockAllBackgrounds</ModStageDir>
      <ZipPath>$(MSBuildProjectDirectory)\dist\UnlockAllBackgrounds-$(Version)-SPT5.0.zip</ZipPath>
    </PropertyGroup>
    <RemoveDir Directories="$(StagingDir)" />
    <MakeDir Directories="$(ModStageDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModStageDir)" />
    <Delete Files="$(ZipPath)" />
    <ZipDirectory SourceDirectory="$(StagingDir)" DestinationFile="$(ZipPath)" />
    <RemoveDir Directories="$(StagingDir)" />
    <Message Importance="high" Text="Release archive: $(ZipPath)" />
  </Target>

</Project>